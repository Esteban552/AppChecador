# Base URL de la API de asistencia.
#
# El prefijo EXPO_PUBLIC_ es obligatorio: Expo solo expone al bundle las
# variables que empiezan asi. Sin el, process.env.EXPO_PUBLIC_API_URL llega
# undefined y el cliente cae al default.
#
# OJO con la seguridad: cualquier variable EXPO_PUBLIC_* queda escrita en el
# bundle en texto plano y es legible por cualquiera que instale la app. Por eso
# aqui solo va la URL. Ninguna contrasena, ningun token: si el backend agrega
# autenticacion, ese secreto va a una variable sin el prefijo PUBLIC y se
# inyecta en tiempo de build, no en el codigo.
EXPO_PUBLIC_API_URL=https://huella.cleyvadev.com